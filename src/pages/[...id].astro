---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Comments from '../components/Comments.astro';
import { localeOf, ui, homeUrl } from '../lib/i18n';
import { domains } from '../lib/domains';
import { allNotes, displayDate, monthTitle, monthUrl, readingTime, tagUrl } from '../lib/notes';
import { formatInstant, displayOffset, rawUrl, primarySource } from '../lib/content-metadata.mjs';
import { buildVersion, sourceVersionUrl } from '../lib/raw-bundle.mjs';
import { fileURLToPath } from 'node:url';
export async function getStaticPaths() { return (await allNotes('all')).map(note => ({ params: { id: note.id }, props: { note } })); }
const { note } = Astro.props;
const locale = localeOf(note.id);
const t = ui(locale);
const { Content, headings } = await render(note);
const sections = headings.filter(heading => heading.depth === 2 && heading.slug !== 'footnote-label');
const sourcePath = `src/content/notes/${note.id}.md`;
const source = primarySource(note.data);
const version = buildVersion(fileURLToPath(new URL('../../', import.meta.url)));
const versionUrl = sourceVersionUrl(note.id, version);
const firstInstant = note.data.created_at || note.data.first_recorded_at;
const firstEvidence = note.data.first_recorded_commit && `https://github.com/irideas/notes/commit/${note.data.first_recorded_commit}`;
const schema = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: note.data.title, description: note.data.description,
  datePublished: note.data.date, dateModified: note.data.generated.at,
  ...(note.data.created_at && { dateCreated: note.data.created_at }),
  author: { '@type': 'Person', name: 'irideas', url: 'https://github.com/irideas' },
  mainEntityOfPage: new URL(`/${note.id}/`, Astro.site).href,
  inLanguage: locale,
  keywords: note.data.tags.map(tag => locale === 'en' ? domains[tag].english : tag),
  encoding: { '@type': 'MediaObject', contentUrl: new URL(rawUrl(note.id), Astro.site).href, encodingFormat: 'text/markdown' },
  citation: note.data.sources.map(item => ({
    '@type': 'CreativeWork', name: item.title, url: item.resource,
    ...(item.author_name && { author: { '@type': 'Person', name: item.author_name } }),
    ...(item.published_on && { datePublished: item.published_on }),
  })),
};
---
<Base locale={locale} title={note.data.title} description={note.data.description} image={note.data.cover?.src} type="article" markdown={rawUrl(note.id)}>
  <article class="article-shell">
    <header class="article-header">
      <a class="back-link" href={monthUrl(note.data.date.slice(0, 7), locale)}>← {monthTitle(note.data.date.slice(0, 7), locale)}</a>
      <div class="metadata"><span>{t.published} <time datetime={note.data.date}>{displayDate(note.data.date, locale)}</time></span>{note.data.asOf && <span>{t.asOf} <time datetime={note.data.asOf}>{displayDate(note.data.asOf, locale)}</time></span>}<span>{t.minutes.replace('{n}', String(readingTime(note.body)))}</span></div>
      <h1>{note.data.title}</h1><p class="article-description">{note.data.description}</p>
      <div class="article-timestamps metadata" title={t.timeZone}>
        <span>{note.data.created_at ? t.created : <a href={firstEvidence} title={t.firstRecordedHint}>{t.firstRecorded}</a>} <time datetime={firstInstant}>{formatInstant(firstInstant, locale)}</time></span>
        <span>{t.updated} <time datetime={note.data.generated.at}>{formatInstant(note.data.generated.at, locale)}</time></span>
        <span class="time-zone">{displayOffset}</span>
      </div>
      <div class="article-tools"><a href={rawUrl(note.id)}>{t.markdown}</a><a href="/raw/index.md">{t.knowledgeBundle}</a>{versionUrl && <a href={versionUrl}>{t.sourceVersion}</a>}</div>
      {note.data.tags.length > 0 && <div class="labels" aria-label={t.domains}>{note.data.tags.map(tag => <a class="label" href={tagUrl(tag,locale)}>{locale === 'en' ? domains[tag].english : tag}</a>)}</div>}
      {source && <div class="source-note"><span class="source-label">{t.source}</span><a href={source.resource}>{source.author_name && `${source.author_name} · `}{source.title}</a><p>{source.publication}{source.published_on && <> · {t.sourcePublished} <time datetime={source.published_on}>{displayDate(source.published_on,locale)}</time></>}</p></div>}
    </header>
    {note.data.cover && <figure class="article-cover"><Image src={note.data.cover} alt={note.data.coverAlt || ''} widths={[720, 1100, 1500]} sizes="(max-width: 800px) 100vw, 900px" width={1500} format="webp" loading="eager" />{note.data.coverCredit && <figcaption>{note.data.coverCredit}</figcaption>}</figure>}
    <div class:list={['article-reading', { 'has-toc': sections.length > 1 }]}>
      {sections.length > 1 && <aside class="article-sidebar"><details class="article-toc" open><summary aria-label={t.toc}><svg class="toc-button-icon" viewBox="0 0 20 20" width="17" height="17" aria-hidden="true"><path d="M6 5h11M6 10h11M6 15h11M2 5h1M2 10h1M2 15h1" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg><span class="toc-desktop-label">{t.toc}</span><span class="toc-mobile-label">{t.tocButton}</span></summary><nav aria-label={t.toc}><ol>{sections.map(section => <li><a href={`#${section.slug}`}>{section.text}</a></li>)}</ol></nav></details></aside>}
      <div class="article-main">
        <div class="prose"><Content /></div>
        <footer class="article-end">
          <div><p>{t.compiled}</p>{note.data.revision && <p class="revision-note">{t.revision} {note.data.revision}</p>}</div>
          <div class="article-links"><a href={rawUrl(note.id)}>{t.markdown}</a><a href={`https://github.com/irideas/notes/commits/main/${sourcePath}`}>{t.history}</a><a href={`https://github.com/irideas/notes/issues/new?template=content-correction.yml&title=${encodeURIComponent(`${t.correctionTitle}${note.data.title}`)}`}>{t.correction}</a><a href={homeUrl(locale)}>{t.allArticles} ↗</a></div>
        </footer>
        <Comments id={note.id} locale={locale} />
      </div>
    </div>
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  </article>
</Base>
<script>
  const toc = document.querySelector<HTMLDetailsElement>('.article-toc');
  if (toc) {
    const desktop = window.matchMedia('(min-width: 1024px)');
    const arrangeToc = () => { toc.open = desktop.matches; };
    arrangeToc();
    desktop.addEventListener('change', arrangeToc);

    const links = [...toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
    const sections = links.map(link => ({ link, heading: document.getElementById(decodeURIComponent(link.hash.slice(1))) }));
    const button = toc.querySelector('summary');
    for (const { link, heading } of sections) link.addEventListener('click', () => {
      if (desktop.matches) return;
      toc.open = false;
      if (heading) {
        heading.setAttribute('tabindex', '-1');
        window.requestAnimationFrame(() => heading.focus({ preventScroll: true }));
      }
    });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && !desktop.matches && toc.open) { toc.open = false; button?.focus(); }
    });
    document.addEventListener('click', event => {
      if (!desktop.matches && toc.open && event.target instanceof Node && !toc.contains(event.target)) toc.open = false;
    });
    let scheduled = false;
    const updateCurrentSection = () => {
      let current: HTMLAnchorElement | undefined;
      for (const { link, heading } of sections) {
        if (heading && heading.getBoundingClientRect().top <= 160) current = link;
      }
      for (const link of links) {
        if (link === current) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      }
      scheduled = false;
    };
    window.addEventListener('scroll', () => {
      if (!scheduled) {
        scheduled = true;
        window.requestAnimationFrame(updateCurrentSection);
      }
    }, { passive: true });
    updateCurrentSection();
  }
</script>
