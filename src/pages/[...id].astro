---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Comments from '../components/Comments.astro';
import { localeOf, ui, homeUrl } from '../lib/i18n';
import { domains } from '../lib/domains';
import { allNotes, displayDate, monthTitle, monthUrl, readingTime, tagUrl } from '../lib/notes';
export async function getStaticPaths() { return (await allNotes('all')).map(note => ({ params: { id: note.id }, props: { note } })); }
const { note } = Astro.props;
const locale = localeOf(note.id);
const t = ui(locale);
const { Content, headings } = await render(note);
const sections = headings.filter(heading => heading.depth === 2);
const sourcePath = `src/content/notes/${note.id}.md`;
const schema = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: note.data.title, description: note.data.description,
  datePublished: note.data.date, dateModified: note.data.updated || note.data.date,
  author: { '@type': 'Person', name: 'irideas', url: 'https://github.com/irideas' },
  mainEntityOfPage: new URL(`/${note.id}/`, Astro.site).href,
  inLanguage: locale,
  keywords: note.data.tags.map(tag => locale === 'en' ? domains[tag].english : tag),
  ...(note.data.source && { citation: {
    '@type': 'CreativeWork', name: note.data.source.title, url: note.data.source.url,
    author: { '@type': 'Person', name: note.data.source.author },
    datePublished: note.data.source.date,
  } }),
};
---
<Base locale={locale} title={note.data.title} description={note.data.description} image={note.data.cover?.src} type="article">
  <article class="article-shell">
    <header class="article-header">
      <a class="back-link" href={monthUrl(note.data.date.slice(0, 7), locale)}>← {monthTitle(note.data.date.slice(0, 7), locale)}</a>
      <div class="metadata"><span>{t.published} <time datetime={note.data.date}>{displayDate(note.data.date, locale)}</time></span>{note.data.updated && note.data.updated !== note.data.date && <span>{t.updated} <time datetime={note.data.updated}>{displayDate(note.data.updated, locale)}</time></span>}{note.data.asOf && <span>{t.asOf} <time datetime={note.data.asOf}>{displayDate(note.data.asOf, locale)}</time></span>}<span>{t.minutes.replace('{n}', String(readingTime(note.body)))}</span></div>
      <h1>{note.data.title}</h1><p class="article-description">{note.data.description}</p>
      {note.data.tags.length > 0 && <div class="labels" aria-label={t.domains}>{note.data.tags.map(tag => <a class="label" href={tagUrl(tag,locale)}>{locale === 'en' ? domains[tag].english : tag}</a>)}</div>}
      {note.data.source && <div class="source-note"><span class="source-label">{t.source}</span><a href={note.data.source.url}>{note.data.source.author} · {note.data.source.title}</a><p>{note.data.source.publication}{note.data.source.date && <> · {t.sourcePublished} <time datetime={note.data.source.date}>{displayDate(note.data.source.date,locale)}</time></>}</p></div>}
    </header>
    {note.data.cover && <figure class="article-cover"><Image src={note.data.cover} alt={note.data.coverAlt || ''} widths={[720, 1100, 1500]} sizes="(max-width: 800px) 100vw, 900px" width={1500} format="webp" loading="eager" />{note.data.coverCredit && <figcaption>{note.data.coverCredit}</figcaption>}</figure>}
    <div class:list={['article-reading', { 'has-toc': sections.length > 1 }]}>
      {sections.length > 1 && <aside class="article-sidebar"><details class="article-toc" open><summary>{t.toc}</summary><nav aria-label={t.toc}><ol>{sections.map(section => <li><a href={`#${section.slug}`}>{section.text}</a></li>)}</ol></nav></details></aside>}
      <div class="article-main">
        <div class="prose"><Content /></div>
        <footer class="article-end">
          <div><p>{t.compiled}</p>{note.data.revision && <p class="revision-note">{t.revision} {note.data.revision}</p>}</div>
          <div class="article-links"><a href={`https://github.com/irideas/notes/blob/main/${sourcePath}`}>{t.markdown}</a><a href={`https://github.com/irideas/notes/commits/main/${sourcePath}`}>{t.history}</a><a href={`https://github.com/irideas/notes/issues/new?template=content-correction.yml&title=${encodeURIComponent(`${t.correctionTitle}${note.data.title}`)}`}>{t.correction}</a><a href={homeUrl(locale)}>{t.allArticles} ↗</a></div>
        </footer>
        <Comments id={note.id} locale={locale} />
      </div>
    </div>
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  </article>
</Base>
<script>
  const toc = document.querySelector<HTMLDetailsElement>('.article-toc');
  if (toc) {
    const desktop = window.matchMedia('(min-width: 1024px)');
    const arrangeToc = () => { toc.open = desktop.matches; };
    arrangeToc();
    desktop.addEventListener('change', arrangeToc);

    const links = [...toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
    const sections = links.map(link => ({ link, heading: document.getElementById(decodeURIComponent(link.hash.slice(1))) }));
    let scheduled = false;
    const updateCurrentSection = () => {
      let current: HTMLAnchorElement | undefined;
      for (const { link, heading } of sections) {
        if (heading && heading.getBoundingClientRect().top <= 160) current = link;
      }
      for (const link of links) {
        if (link === current) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      }
      scheduled = false;
    };
    window.addEventListener('scroll', () => {
      if (!scheduled) {
        scheduled = true;
        window.requestAnimationFrame(updateCurrentSection);
      }
    }, { passive: true });
    updateCurrentSection();
  }
</script>
