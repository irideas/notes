---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { allNotes, displayDate, monthTitle, monthUrl, readingTime, tagUrl } from '../lib/notes';
export async function getStaticPaths() { return (await allNotes()).map(note => ({ params: { id: note.id }, props: { note } })); }
const { note } = Astro.props;
const { Content } = await render(note);
---
<Base title={note.data.title} description={note.data.description} image={note.data.cover?.src} type="article">
  <article class="article-shell">
    <header class="article-header"><a class="back-link" href={monthUrl(note.data.date.slice(0, 7))}>← {monthTitle(note.data.date.slice(0, 7))}的记录</a><div class="metadata"><time datetime={note.data.date}>{displayDate(note.data.date)}</time><span>约 {readingTime(note.body)} 分钟</span></div><h1>{note.data.title}</h1><p class="article-description">{note.data.description}</p>{note.data.tags.length > 0 && <div class="labels" aria-label="文章标签">{note.data.tags.map(tag => <a class="label" href={tagUrl(tag)}>{tag}</a>)}</div>}</header>
    {note.data.cover && <figure class="article-cover"><Image src={note.data.cover} alt={note.data.coverAlt || ''} widths={[720, 1100, 1500]} sizes="(max-width: 800px) 100vw, 900px" width={1500} format="webp" loading="eager" />{note.data.coverCredit && <figcaption>{note.data.coverCredit}</figcaption>}</figure>}
    <div class="prose"><Content /></div>
    <footer class="article-end"><span>这篇先记到这里。</span><a href="/">回到所有记录 ↗</a></footer>
  </article>
</Base>
