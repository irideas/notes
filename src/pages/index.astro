---
import Base from '../layouts/Base.astro';
import NoteCard from '../components/NoteCard.astro';
import { Image } from 'astro:assets';
import meadow from '../assets/meadow.png';
import { allNotes, groupedMonths, monthTitle, monthUrl } from '../lib/notes';
const notes = await allNotes();
const [latest, ...rest] = notes;
const months = groupedMonths(notes);
---
<Base image={meadow.src}>
  <div class="shell">
    <section class="home-intro" aria-labelledby="home-title"><div class="intro-copy"><span class="eyebrow">想法 · 经验 · 故事</span><h1 id="home-title">看到好东西，<br />记一下<span class="title-dot">。</span></h1><p>读到的、做过的、后来想明白的。<br />随手记一点，留着以后慢慢看。</p></div><figure class="intro-photo"><Image src={meadow} alt="开阔的绿色草原、远处的山丘与明亮的蓝天白云。" widths={[600, 900, 1300]} sizes="(max-width: 700px) 100vw, 62vw" width={1300} format="webp" loading="eager" /><figcaption class="sr-only">站点视觉图片由 AI 生成。</figcaption></figure></section>
    <section aria-labelledby="latest-title"><div class="section-heading"><h2 id="latest-title">最近记的</h2><a href="/archive/">全部记录 <span aria-hidden="true">↗</span></a></div>
      {latest ? <NoteCard note={latest} featured /> : <p class="empty-state">这里很快就会有第一篇记录。</p>}
      {rest.length > 0 && <div class="note-grid">{rest.map(note => <NoteCard note={note} />)}</div>}
    </section>
    <section class="months-section" aria-labelledby="months-title"><div class="section-heading"><h2 id="months-title">按月翻翻</h2><span class="subtle">零散的记录，也有自己的顺序</span></div><div class="month-grid">{months.map(({ month, notes }) => <a class="month-link" href={monthUrl(month)}><span class="month-number">{month.slice(5)}</span><span><strong>{monthTitle(month)}</strong><small>{notes.length} 篇记录</small></span><span class="month-arrow" aria-hidden="true">↗</span></a>)}</div></section>
    <aside class="home-aside"><p>一个放想法和经验的地方。<br />也欢迎你带着自己的理解，随便翻翻。</p><a href="/about/">关于这里 ↗</a></aside>
  </div>
</Base>
