---
import Page from '../../components/Domain.astro';
import { allNotes } from '../../lib/notes';
import { domains } from '../../lib/domains';
export async function getStaticPaths() {
 const notes = await allNotes('zh-CN');
 return [...new Set(notes.flatMap(note => note.data.tags))].map(tag => ({params:{tag:tag},props:{tag,notes:notes.filter(note => note.data.tags.includes(tag))}}));
}
const { tag, notes } = Astro.props;
---
<Page locale="zh-CN" tag={tag} notes={notes} />
