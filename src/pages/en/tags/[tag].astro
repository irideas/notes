---
import Page from '../../../components/Domain.astro';
import { allNotes } from '../../../lib/notes';
import { domains } from '../../../lib/domains';
export async function getStaticPaths() {
 const notes = await allNotes('en');
 return [...new Set(notes.flatMap(note => note.data.tags))].map(tag => ({params:{tag:domains[tag].slug},props:{tag,notes:notes.filter(note => note.data.tags.includes(tag))}}));
}
const { tag, notes } = Astro.props;
---
<Page locale="en" tag={tag} notes={notes} />
