---
import Base from '../../layouts/Base.astro';
import { allNotes, groupedMonths, monthTitle, monthUrl, noteUrl } from '../../lib/notes';
const notes = await allNotes();
const months = groupedMonths(notes);
---
<Base title="年月归档" description="按年月回看这里记录过的想法、经验和故事。"><div class="reading-shell page-intro"><span class="eyebrow">慢慢积累</span><h1>记过的，都在这儿。</h1><p class="page-description">按年月翻一翻，看看当时在想什么。</p>{months.map(({ month, notes }) => <section class="archive-group"><h2><a href={monthUrl(month)}>{monthTitle(month)}</a><span>{notes.length} 篇</span></h2><ol class="archive-list">{notes.map(note => <li><time datetime={note.data.date}>{note.data.date.slice(8)} 日</time><a href={noteUrl(note)}>{note.data.title}<span aria-hidden="true">↗</span></a></li>)}</ol></section>)}</div></Base>
