---
import Page from '../../components/Month.astro';
import { allNotes, groupedMonths } from '../../lib/notes';
export async function getStaticPaths() { return groupedMonths(await allNotes('zh-CN')).map(({month,notes}) => ({params:{period:month.replace('-', '/')},props:{month,notes}})); }
const { month, notes } = Astro.props;
---
<Page locale="zh-CN" month={month} notes={notes} />
