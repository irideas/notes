---
import Base from '../layouts/Base.astro';
import { ui, homeUrl, type Locale } from '../lib/i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = ui(locale);
---
<Base locale={locale} title={t.notFound}><div class="reading-shell page-intro"><span class="eyebrow">404</span><h1>{t.notFound}</h1><p class="page-description">{t.notFoundDescription}</p><p><a class="read-link" href={homeUrl(locale)}>{t.backHome} ↗</a></p></div></Base>
