---
import Base from '../layouts/Base.astro';
import NoteCard from './NoteCard.astro';
import { allNotes, groupedMonths, monthTitle, monthUrl } from '../lib/notes';
import { ui, prefix, articleCount, type Locale } from '../lib/i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = ui(locale);
const [latest, ...rest] = await allNotes(locale);
const months = groupedMonths([...(latest ? [latest] : []), ...rest]);
---
<Base locale={locale} image={latest?.data.cover?.src}>
  <div class="shell">
    <section class="home-intro" aria-labelledby="home-title"><div><span class="eyebrow">{t.eyebrow}</span><h1 id="home-title">{t.titleFirst}<span class="title-line">{t.titleLast}<span class="title-dot">{t.dot}</span></span></h1></div><p>{t.introFirst}<br />{t.introLast}</p></section>
    <section aria-labelledby="latest-title"><div class="section-heading"><h2 id="latest-title">{t.latest}</h2><a href={`${prefix(locale)}/archive/`}>{t.allArticles} <span aria-hidden="true">↗</span></a></div>
      {latest ? <NoteCard note={latest} featured /> : <p class="empty-state">{t.empty}</p>}
      {rest.length > 0 && <div class="note-grid">{rest.map(note => <NoteCard note={note} />)}</div>}
    </section>
    <section class="months-section" aria-labelledby="months-title"><div class="section-heading"><h2 id="months-title">{t.months}</h2><span class="subtle">{t.byPublication}</span></div><ol class="month-list">{months.map(({ month, notes }) => <li><a class="month-link" href={monthUrl(month,locale)}><strong>{monthTitle(month,locale)}</strong><span class="month-count">{articleCount(notes.length,locale)}</span><span class="month-arrow" aria-hidden="true">↗</span></a></li>)}</ol></section>
    <aside class="home-aside"><p>{t.homeAsideFirst}<br />{t.homeAsideLast}</p><a href={`${prefix(locale)}/about/`}>{t.aboutSite} ↗</a></aside>
  </div>
</Base>
