---
import analytics from '../data/analytics.json';
interface Props { enabled: boolean; }
const config = { token: analytics.cloudflareToken, productionOrigin: Astro.site?.origin, enabled: Astro.props.enabled };
---
<script id="web-analytics-config" type="application/json" set:html={JSON.stringify(config).replace(/</g, '\\u003c')} />
<script>
  import { initializeAnalytics } from '../lib/analytics.mjs';
  const config = document.getElementById('web-analytics-config');
  if (config?.textContent) initializeAnalytics(JSON.parse(config.textContent));
</script>
