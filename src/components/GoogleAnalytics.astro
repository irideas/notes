---
import { google } from '../lib/google.mjs';
import { ui, prefix, type Locale } from '../lib/i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = ui(locale);
---
{google.measurementId && <section id="analytics-consent" class="analytics-consent" aria-labelledby="analytics-consent-title" data-measurement-id={google.measurementId} data-production-origin={Astro.site?.origin} hidden>
  <h2 id="analytics-consent-title">{t.analyticsHeading}</h2>
  <p>{t.analyticsConsent} <a data-analytics-details href={`${prefix(locale)}/about/#analytics-privacy`}>{t.analyticsDetails}</a></p>
  <div class="analytics-actions"><button type="button" data-analytics-accept>{t.analyticsAccept}</button><button type="button" data-analytics-deny>{t.analyticsDeny}</button></div>
</section>}
<script>
  import { initializeAnalytics } from '../lib/analytics-consent.mjs';
  initializeAnalytics();
</script>
<style>
  .analytics-consent{position:fixed;z-index:30;bottom:16px;left:50%;transform:translateX(-50%);width:min(660px,calc(100% - 32px));max-height:calc(100dvh - 32px);overflow:auto;padding:20px 24px;background:var(--surface);border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow);font-size:14px;line-height:1.65}
  .analytics-consent h2{font-size:17px;margin-bottom:6px}
  .analytics-consent a{text-decoration:underline;text-underline-offset:3px;white-space:nowrap}
  .analytics-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:14px}
  .analytics-actions button{padding:8px 18px;min-height:44px;background:var(--page);border:1px solid var(--green);border-radius:7px;cursor:pointer}
  .analytics-actions button:hover{background:var(--soft)}
</style>
