---
import '../styles/global.css';
import { ui, prefix, homeUrl, alternatePath, localeFromPath, type Locale } from '../lib/i18n';
import { getImage } from 'astro:assets';
import meadow from '../assets/meadow.png';
import type { ImageMetadata } from 'astro';
import CloudflareAnalytics from '../components/CloudflareAnalytics.astro';
import { google } from '../lib/google.mjs';
interface Props { title?: string; description?: string; image?: ImageMetadata; imageAlt?: string; type?: string; locale?: Locale; markdown?: string; noindex?: boolean; modifiedAt?: string; }
const locale = Astro.props.locale || localeFromPath(Astro.url.pathname);
const t = ui(locale);
const { title, description = t.siteDescription, image, imageAlt, type = 'website', noindex = false, modifiedAt } = Astro.props;
const siteTitle = t.siteTitle;
const otherLocale: Locale = locale === 'en' ? 'zh-CN' : 'en';
const pagePath = Astro.url.pathname === '/404/' ? '/404.html' : Astro.url.pathname;
const alternate = alternatePath(pagePath, otherLocale);
const pageTitle = title ? `${title} · ${siteTitle}` : siteTitle;
const canonical = new URL(pagePath, Astro.site);
const current = Astro.url.pathname;
const scenery = await getImage({ src: meadow, width: 1400, format: 'webp', quality: 70 });
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f7f8f3" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {google.siteVerification && <meta name="google-site-verification" content={google.siteVerification} />}
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale} href={canonical} />
    <link rel="alternate" hreflang={otherLocale} href={new URL(alternate, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(alternatePath(pagePath, 'zh-CN'), Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={siteTitle} href={`${prefix(locale)}/rss.xml`} />
    {Astro.props.markdown && <link rel="alternate" type="text/markdown" href={new URL(Astro.props.markdown, Astro.site)} title={locale === 'en' ? 'Raw Markdown' : 'Markdown 原稿'} />}
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'zh_CN'} />
    <meta property="og:locale:alternate" content={locale === 'en' ? 'zh_CN' : 'en_US'} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <>
      <meta property="og:image" content={new URL(image.src, Astro.site)} />
      <meta property="og:image:width" content={image.width} />
      <meta property="og:image:height" content={image.height} />
      <meta property="og:image:alt" content={imageAlt} />
    </>}
    {type === 'article' && modifiedAt && <meta property="article:modified_time" content={modifiedAt} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
  </head>
  <body style={`--scenery: url("${scenery.src}")`}>
    <a class="skip-link" href="#main">{t.skip}</a>
    <header class="site-header shell">
      <a class="brand" href={homeUrl(locale)} aria-label={t.homeLabel}><span class="brand-mark" aria-hidden="true">{locale === 'en' ? 'N' : '记'}</span><span>{siteTitle}<span class="brand-en">NOTES BY IRIDEAS</span></span></a>
      <nav aria-label={locale === 'en' ? 'Main navigation' : '主导航'}>
        <a href={homeUrl(locale)} aria-current={current === homeUrl(locale) ? 'page' : undefined}>{t.articles}</a>
        <a href={`${prefix(locale)}/archive/`} aria-current={current.startsWith(`${prefix(locale)}/archive`) ? 'page' : undefined}>{t.archive}</a>
        <a href={`${prefix(locale)}/about/`} aria-current={current === `${prefix(locale)}/about/` ? 'page' : undefined}>{t.about}</a>
        <a class="language-switch" href={alternate} lang={otherLocale} hreflang={otherLocale} aria-label={t.switchLanguage} title={t.switchLanguage}>
          <svg viewBox="0 0 40 28" width="35" height="25" aria-hidden="true"><text x="1" y="19" font-size="17" fill="currentColor">文</text><path d="M19 23 24 5" fill="none" stroke="currentColor" stroke-width="1.2"/><text x="25" y="20" font-size="16" fill="currentColor">A</text></svg>
        </a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer shell"><p>{t.footer}</p><div><a href={`${prefix(locale)}/rss.xml`}>RSS</a><a href="https://github.com/irideas/notes" target="_blank" rel="noopener noreferrer">GitHub ↗</a></div></footer>
    <CloudflareAnalytics enabled={!noindex} />
  </body>
</html>
<style>
  .site-footer{flex-wrap:wrap}
  .site-footer>div{flex-wrap:wrap;align-items:center}
</style>
