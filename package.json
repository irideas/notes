{
  "name": "irideas-notes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build --force",
    "preview": "astro preview --host 127.0.0.1",
    "check": "node --test scripts/check-metadata.test.mjs scripts/check-analytics.test.mjs && npm run build && node scripts/check-project.mjs",
    "discussion:ensure": "node scripts/discussions.mjs ensure",
    "discussion:check": "node scripts/discussions.mjs check",
    "dev:stop": "astro dev stop",
    "preview:stop": "astro preview stop"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.3",
    "@astrojs/rss": "4.0.19",
    "astro": "7.3.8",
    "beautiful-mermaid": "1.1.3",
    "satteri": "0.10.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "fast-xml-parser": "5.11.2",
    "github-slugger": "2.0.0",
    "parse5": "8.0.1",
    "yaml": "2.9.1"
  }
}
